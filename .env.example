# Copy this file to `.env` and fill in your credentials.
# `.env` is git-ignored — never commit it.

# DeepSeek (OpenAI-compatible) defaults; change if you use another gateway.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Agent behaviour (optional)
# MAX_ITERATIONS=40
# MAX_TOOL_OUTPUT_CHARS=8000
# CONTEXT_CHAR_BUDGET=36000
# CONTEXT_KEEP_RECENT=8
# COMMAND_TIMEOUT=120
# REQUEST_TIMEOUT=300
# MAX_RETRIES=3

# Sandbox workspace (optional; defaults to ./workspace)
# WORKSPACE=workspace
